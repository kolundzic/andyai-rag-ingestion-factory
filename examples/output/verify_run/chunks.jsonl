{"chunk_id": "chk_663bdab55098d30ef6754409", "chunk_index": 0, "created_at": "2026-05-08T10:54:01.794576+00:00", "document_id": "doc_de7201a41e2296ee", "file_name": "demo_document.txt", "page_end": 1, "page_start": 1, "section_title": "AndyAI RAG Ingestion Factory Demo", "text": "# AndyAI RAG Ingestion Factory Demo", "text_hash": "ec83b14a42fac0f3dc6f90774f27218ae94fc870be041dc6006989f138697760"}
{"chunk_id": "chk_b7ef51af2e181aa082732f72", "chunk_index": 1, "created_at": "2026-05-08T10:54:01.794576+00:00", "document_id": "doc_de7201a41e2296ee", "file_name": "demo_document.txt", "page_end": 1, "page_start": 1, "section_title": "AndyAI RAG Ingestion Factory Demo", "text": "This is a demonstration document for the AndyAI RAG Ingestion Factory.\nThe purpose of the factory is to convert raw documents into structured chunks.", "text_hash": "723a58500b5fa06915fa3b6924be23118f4012251647d9bc6db8c2464dbd1d89"}
{"chunk_id": "chk_aa4b913410d3f23eb7b90771", "chunk_index": 2, "created_at": "2026-05-08T10:54:01.794576+00:00", "document_id": "doc_de7201a41e2296ee", "file_name": "demo_document.txt", "page_end": 2, "page_start": 2, "section_title": "AndyAI RAG Ingestion Factory Demo", "text": "A serious RAG system needs document identity, page identity, chunk identity, and citation identity.\nWithout these controls, answers become difficult to verify.", "text_hash": "28ac5fb2cdff0677e6ab072c370175a00eed40e753f5481a928ac5601171e653"}
{"chunk_id": "chk_61e50b7864195f1a0d612c06", "chunk_index": 3, "created_at": "2026-05-08T10:54:01.794576+00:00", "document_id": "doc_de7201a41e2296ee", "file_name": "demo_document.txt", "page_end": 3, "page_start": 3, "section_title": "AndyAI RAG Ingestion Factory Demo", "text": "The ingestion pipeline registers the file, extracts text, normalizes structure, creates chunks, stores metadata, and prepares indexes.\nThe retrieval layer later uses these chunks to build evidence-backed answers.", "text_hash": "d17248c1ad00b1338235e7bf106ad685e84ddd6f70227f7391ac78be5cf9f2bc"}
