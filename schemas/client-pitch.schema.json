{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientPitch",
  "type": "object",
  "required": ["product", "site", "version", "one_liner", "problem", "solution", "value_points", "cta"],
  "properties": {
    "product": { "type": "string" },
    "site": { "type": "string" },
    "version": { "type": "string" },
    "one_liner": { "type": "string" },
    "problem": { "type": "string" },
    "solution": { "type": "string" },
    "value_points": { "type": "array", "items": { "type": "string" } },
    "cta": { "type": "string" }
  }
}
