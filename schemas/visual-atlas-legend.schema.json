    "id": { "type": "string" },
    "title": { "type": "string" },
    "image": { "type": "string" },
    "category": { "type": "string" },
    "one_line_meaning": { "type": "string" },
    "what_this_shows": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "key_elements": { "type": "array", "items": { "type": "string" } },
    "process_flow": { "type": "array", "items": { "type": "string" } },
    "practical_takeaway": { "type": "string" },
    "andyai_angle": { "type": "string" }
